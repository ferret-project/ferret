# ── Required ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Master key for uploaded photos/documents (each household's file key is sealed with it).
# Generate with: openssl rand -base64 32
# LOSING IT MAKES UPLOADED FILES UNREADABLE. Keep a copy in your password manager,
# and not in the same backup as the data folder.
FILES_KEY=

# The URL people (and Claude's MCP) use to reach Ferret.
PUBLIC_URL=http://localhost:8787

# ── Optional ────────────────────────────────────────────────────────────────
# Extra origins allowed to call the API with a sign-in, comma separated. Unset: the Vite dev server
# (http://localhost:5173) outside production, nothing in production — leave it unset there.
# TRUSTED_ORIGINS=

# The reverse proxy (e.g. Traefik) whose X-Forwarded-For header is believed, as IP addresses or CIDR
# ranges, comma separated. Anything else is taken to come from its own address, so nobody can dodge the
# sign-in limits by claiming another one. Unset: loopback only. Set it BEFORE deploying behind a proxy on
# another host, or every visitor looks like the proxy and shares one set of limits.
# TRUSTED_PROXIES=10.0.0.2

# Single sign-on (help: hosting/single-sign-on). OpenID Connect — Authelia, Pocket ID, Authentik, Keycloak…: the
# provider's address and the client registered there (redirect URI PUBLIC_URL/api/auth/callback/oidc).
# OIDC_ISSUER=https://auth.example.lan
# OIDC_CLIENT_ID=ferret
# OIDC_CLIENT_SECRET=
# OIDC_NAME=Authelia
# OIDC_CLIENT_AUTH=basic
# Or sign in by a forward-auth proxy's headers — believed ONLY from these addresses (the proxy must replace the
# headers on what it passes on): TRUSTED_HEADER_USER / _EMAIL / _NAME default to Remote-User / -Email / -Name.
# TRUSTED_HEADER_AUTH=true
# TRUSTED_HEADER_PROXIES=10.0.0.2

# Largest upload accepted, in MB (default 25).
# MAX_UPLOAD_MB=25

# Set to false once everyone in the family has an account (invited people can still join, from their link).
# Every account but the first must confirm its email, so sign-up past the first account needs MAIL_URL.
ALLOW_SIGNUP=true

# ── Nightly backups ─────────────────────────────────────────────────────────
# A folder on ANOTHER machine (e.g. an NFS share on the NAS), mounted into the container (FERRET_BACKUPS below).
# Each night: the database (encrypted with a key made from FILES_KEY) and any new files are copied there, then
# opened again to check they'd restore. Status in Settings → Server (the server admin: the first account, or
# whoever it was handed to). Restore with `node dist/cli.js backup restore` (see Settings → Server).
# BACKUP_DIR=/backups
# FERRET_BACKUPS=/mnt/nas/ferret-backups
# BACKUP_HOUR=3
# BACKUP_KEEP=14

# Where the database and uploaded files live (inside the container: /data).
# FERRET_DATA=/mnt/pool/apps/ferret
# FERRET_PORT=8787
# FERRET_TAG=latest

# ── Optional AI features — each switches on when its settings are present ──────
# All run in the background (one job at a time per kind, retried with backoff if busy).

# Photo analysis + embeddings: photos are described, their text read, and item fields suggested.
# OLLAMA_URL=http://gpu.lan:11434
# VISION_MODEL=qwen3-vl:8b
# EMBED_MODEL=qwen3-embedding:8b

# A stronger text model for Ask Ferret and reading documents (any OpenAI-compatible API).
# Without it, VISION_MODEL does those too.
# CHAT_URL=http://gpu.lan:8000/v1
# CHAT_MODEL=gpt-oss-120b
# CHAT_REASONING=low

# Document text: PDFs and document photos are transcribed by docling (its standard pipeline by default).
# DOCLING_URL=http://docling.lan:5001
# Read pages with granite-docling instead (docling's VLM pipeline), served OpenAI-style (e.g. by vLLM):
# DOCLING_VLM_URL=http://gpu.lan:8001/v1/chat/completions
# Or any docling form fields as JSON: DOCLING_OPTIONS='{"pipeline":"standard"}'

# Smart search (needs OLLAMA_URL too): items are found by meaning, including inside documents.
# Use a separate collection per environment (e.g. ferret-dev for local development).
# QDRANT_URL=http://qdrant.lan:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=ferret
# Optional reranker (vLLM /v1/rerank) for better ordering and snippets, and exact-passage matches.
# RERANK_URL=http://gpu.lan:8002
# RERANK_MODEL=reranker

# ── Maintenance reminders by push (the installed PWA). Generate keys with
# `npx web-push generate-vapid-keys`; keep the private key out of git.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# Reminders go out once a day from this hour, in the server's time zone (set TZ).
# REMIND_HOUR=9
# TZ=America/New_York

# ── Reminders to other apps: ntfy, Pushover, Telegram, email and 100+ more, through the
# apprise-api container (the `apprise` service in compose.yaml). Each person adds their own
# Apprise URLs in Settings → Notifications; they're stored encrypted with the household key.
# APPRISE_URL=http://apprise:8000
# Email for Ferret itself, through Apprise: an Apprise mailto URL to send from (e.g. a Gmail app
# password). Confirms new accounts' email addresses (without it, nobody but the first account can
# sign up), "Forgot your password?", and "email me a link to sign in again" after wrong passwords.
# MAIL_URL=mailtos://you:app-password@gmail.com

# ── Map pictures on property pages (Apple Maps Web Snapshots). Needs an Apple Developer account: create a
# Maps ID and a key with MapKit JS enabled (Certificates, IDs & Profiles → Keys), download its .p8 once.
# The server fetches the pictures, so the key stays here. "Open in Maps" works without any of this.
# APPLE_MAPS_TEAM_ID=
# APPLE_MAPS_KEY_ID=
# The .p8 file's contents on one line: its base64 body, or the PEM with \n for line breaks.
# APPLE_MAPS_PRIVATE_KEY=

# ── Barcode lookup. Ferret always keeps its own barcode book (learned from items you save);
# this adds an online product database for codes nobody has named yet. Only the barcode is
# sent, from the server. UPCitemdb's free tier: 100 lookups a day, no key.
# BARCODE_LOOKUP=upcitemdb
# UPCITEMDB_KEY=
