{
  "name": "ferret-monorepo",
  "private": true,
  "license": "MIT",
  "description": "Ferret — find anything you own. Self-hosted, multi-user home inventory with an API and MCP server.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @ferret/server --filter @ferret/web dev",
    "build": "pnpm --filter @ferret/web build && pnpm --filter @ferret/docs build && pnpm --filter @ferret/server build",
    "docs:dev": "pnpm --filter @ferret/docs dev",
    "start": "pnpm --filter @ferret/server start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm i18n:check && pnpm -r test",
    "i18n:extract": "node scripts/i18n-catalog.mjs --update",
    "i18n:check": "node scripts/i18n-catalog.mjs && node scripts/i18n-audit.mjs",
    "db:generate": "pnpm --filter @ferret/server db:generate",
    "db:migrate": "pnpm --filter @ferret/server db:migrate"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "typescript-ast": "npm:typescript@6.0.3"
  }
}
